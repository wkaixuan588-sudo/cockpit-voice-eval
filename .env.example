# ==== LLM 配置(智谱 GLM: https://open.bigmodel.cn)====
# 复制本文件为 .env 并填入你的 key。所有厂商均兼容 OpenAI 协议,换厂商只改这里。
LLM_API_KEY=your-zhipu-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# SUT 用免费模型模拟"待测车载模型", judge 用更强模型(体现 judge≠SUT 原则)
SUT_MODEL=glm-4-flash
JUDGE_MODEL=glm-4.5-flash   # glm-4.5-flash 关闭 thinking 后单次判定~10s;充值后建议换旗舰 glm-4.6

# 本地无 key 调试流水线时取消注释(mock 模式不调 API)
# SUT_MODE=mock
